{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "opticrop": {
      "root": ".",
      "framework": "flask",
      "entrypoint": "run:app",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "opticrop"
      }
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
